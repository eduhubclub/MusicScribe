{
  "name": "music-scribe",
  "productName": "Music Scribe",
  "version": "0.1.0",
  "description": "Turn songs into playable tabs and parts — fully local, no cloud uploads.",
  "main": "src/main.js",
  "author": "Music Scribe",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.musicscribe.desktop",
    "productName": "Music Scribe",
    "copyright": "Copyright © Music Scribe contributors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../frontend",
        "to": "frontend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "sidecar",
        "to": "sidecar",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Music Scribe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Audio"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "thomaseccles67",
        "repo": "MusicScribe"
      }
    ]
  }
}
